# YYC³ Agent Builder — NAS 生产环境模板
# 复制为 .env.production 并填入真实值；该文件不得提交仓库。

APP_VERSION=0.1.2
LOG_LEVEL=info

# 仅绑定 Tailscale 地址（真实地址只写入 .env.production，不入库）
TAILSCALE_BIND=CHANGE_ME_TAILSCALE_IP

# 执行 API 令牌（必填，建议 32 字节以上随机值）
WORKFLOW_API_TOKEN=CHANGE_ME_WORKFLOW_TOKEN

# 账号体系（Better Auth）
# openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET
BETTER_AUTH_URL=https://agent.yyc3.vip
NEXT_PUBLIC_APP_URL=https://agent.yyc3.vip

# 事务邮件（生产必配，否则注册/重置无法送达）
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
SMTP_FROM="YYC³ <no-reply@yyc3.vip>"

# AI Provider
GOOGLE_GENERATIVE_AI_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# 本地 Redis 由 compose 提供，无需填写；UPSTASH_* 仅在托管部署时使用
# REDIS_URL=redis://redis:6379/0

# 数据库（阶段 A 已接入；未配置时健康检查仍会通过，但登录/云端保存不可用）
# 已定案：NAS 主库、Mac 备库，两台主机各监听 5433；真实主机地址不得写入本模板
# DATABASE_URL=postgres://yyc3_app:CHANGE_ME@CHANGE_ME_NAS_HOST:5433/yyc3_agent?sslmode=prefer
# 只读副本（报表/分析/DR；备库提升为主后需同步切换）
# DATABASE_REPLICA_URL=postgres://yyc3_ro:CHANGE_ME@CHANGE_ME_MAC_HOST:5433/yyc3_agent?sslmode=prefer
# 连接池上限（PgBouncer 前置时保持较小值）
# DATABASE_POOL_MAX=10

# 不可信代码执行（默认 false；公网多租户环境禁止开启）
# false：javascript / tool 节点禁用，conditional 走受限表达式求值
ENABLE_UNSAFE_CODE_NODES=false

# 限流窗口
WORKFLOW_RATE_LIMIT_MAX=20
WORKFLOW_RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_FAIL_MODE=open

# 出站防护
WORKFLOW_HTTP_TIMEOUT_MS=10000
WORKFLOW_HTTP_MAX_BYTES=1048576
