# YYC³ Agent Builder - Environment Variables
# Copy this file to .env.local and fill in your values
# 安全约定：真实密钥只允许出现在 .env.local（已被 .gitignore 忽略），禁止提交与写入文档

# ---- AI Provider ----
# Google AI (Required - for Gemini models and image generation)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here

# OpenAI (Optional - for GPT models if used in workflows)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic / xAI (Optional - for Claude / Grok models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
XAI_API_KEY=your_xai_api_key_here

# ---- 执行 API 访问控制 ----
# 留空 = 开发态开放（会输出降级日志）；生产环境必须设置高强度随机令牌
WORKFLOW_API_TOKEN=
# 前端可选：仅用于内部演示环境（会被打进客户端包，不是机密）；生产建议使用面板内输入框按会话输入
# NEXT_PUBLIC_WORKFLOW_API_TOKEN=
# 每窗口每 IP 最大执行请求数
WORKFLOW_RATE_LIMIT_MAX=20
# 限流窗口（毫秒）
WORKFLOW_RATE_LIMIT_WINDOW_MS=60000

# ---- 多实例共享限流 ----
# 优先使用本地/自建 Redis（NAS compose 内置）；留空则回退到 Upstash REST 或内存实现
# REDIS_URL=redis://127.0.0.1:6379/0
# 托管方案（Upstash Redis / Vercel KV）：两者都配置后自动切换
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Vercel KV 兼容变量：KV_REST_API_URL / KV_REST_API_TOKEN
# Redis 异常时：open（默认放行并告警）| closed（拒绝，保护优先）
# RATE_LIMIT_FAIL_MODE=open

# ---- 出站 HTTP 防护 ----
WORKFLOW_HTTP_TIMEOUT_MS=10000
WORKFLOW_HTTP_MAX_BYTES=1048576

# ---- 数据库（阶段 A 接入后启用；当前代码尚未读取）----
# PG15 主备端口 5433；主备方向见 docs/06-.../004-集群拓扑与部署映射.md
# DATABASE_URL=postgres://yyc3_app:CHANGE_ME@100.65.172.88:5433/yyc3_agent?sslmode=prefer
# DATABASE_REPLICA_URL=postgres://yyc3_ro:CHANGE_ME@100.87.159.21:5433/yyc3_agent?sslmode=prefer
# DATABASE_POOL_MAX=10

# ---- 运行时日志 ----
# debug | info | warn | error | silent
LOG_LEVEL=info
