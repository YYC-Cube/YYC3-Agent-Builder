# YYC³ Agent Builder - Environment Variables
# Copy this file to .env.local and fill in your values

# Google AI (Required - for Gemini models and image generation)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here

# OpenAI (Optional - for GPT models if used in workflows)
OPENAI_API_KEY=your_openai_api_key_here
