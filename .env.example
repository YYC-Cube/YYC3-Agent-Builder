# YYC³ Agent Builder - Environment Variables
# Copy this file to .env.local and fill in your values
# 安全约定：真实密钥只允许出现在 .env.local（已被 .gitignore 忽略），禁止提交与写入文档
# file: .env.example
# description: 环境变量模板 · 开发与生产配置参考
# author: YYC³ Team
# version: v1.0.0
# created: 2026-11-01
# updated: 2026-11-20
# status: active
# tags: [config],[env],[security]
#
# brief: 环境变量模板，提供开发与生产配置参考，真实密钥仅写入 .env.local（不入库）。
#
# details:
# - AI Provider：Google AI（必需）、OpenAI、Anthropic、xAI（可选）
# - 执行 API 访问控制：WORKFLOW_API_TOKEN，生产环境必须设置高强度随机令牌
# - 多实例共享限流：REDIS_URL / UPSTASH_REDIS_REST_URL / Vercel KV
# - 不可信代码执行：ENABLE_UNSAFE_CODE_NODES=false（默认禁用）
# - 出站 HTTP 防护：超时 10s，响应 1 MiB 上限
# - 账号体系：Better Auth（BETTER_AUTH_SECRET 等）
# - 事务邮件：SMTP 配置（生产必配）
# - 数据库：PG15 主备，真实地址仅写入 .env.local
# - 运行时日志：LOG_LEVEL=info
#
# dependencies: 无外部依赖
# notes: 真实密钥禁止提交与写入文档

# ---- AI Provider ----
# Google AI (Required - for Gemini models and image generation)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here

# OpenAI (Optional - for GPT models if used in workflows)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic / xAI (Optional - for Claude / Grok models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
XAI_API_KEY=your_xai_api_key_here

# ---- 执行 API 访问控制 ----
# 留空 = 开发态开放（会输出降级日志）；生产环境必须设置高强度随机令牌
WORKFLOW_API_TOKEN=
# 前端可选：仅用于内部演示环境（会被打进客户端包，不是机密）；生产建议使用面板内输入框按会话输入
# NEXT_PUBLIC_WORKFLOW_API_TOKEN=
# 每窗口每 IP 最大执行请求数
WORKFLOW_RATE_LIMIT_MAX=20
# 限流窗口（毫秒）
WORKFLOW_RATE_LIMIT_WINDOW_MS=60000

# ---- 多实例共享限流 ----
# 优先使用本地/自建 Redis（NAS compose 内置）；留空则回退到 Upstash REST 或内存实现
# REDIS_URL=redis://127.0.0.1:6379/0
# 托管方案（Upstash Redis / Vercel KV）：两者都配置后自动切换
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Vercel KV 兼容变量：KV_REST_API_URL / KV_REST_API_TOKEN
# Redis 异常时：open（默认放行并告警）| closed（拒绝，保护优先）
# RATE_LIMIT_FAIL_MODE=open

# ---- 不可信代码执行 ----
# 默认 false：javascript / tool 节点禁用；conditional 使用受限表达式求值（无 eval / Function / 全局对象）。
# 仅在完全可信的内网单租户环境设为 true；公网多租户环境禁止开启。
ENABLE_UNSAFE_CODE_NODES=false

# ---- 出站 HTTP 防护 ----
WORKFLOW_HTTP_TIMEOUT_MS=10000
WORKFLOW_HTTP_MAX_BYTES=1048576

# ---- 账号体系（Better Auth）----
# 生成：openssl rand -base64 32
BETTER_AUTH_SECRET=
# 站点地址（生产必须改为 https://agent.yyc3.vip）
BETTER_AUTH_URL=http://localhost:3146
# 前端 client 使用的站点地址（与 BETTER_AUTH_URL 一致）
NEXT_PUBLIC_APP_URL=http://localhost:3146

# ---- 事务邮件（SMTP）----
# 未配置时：开发环境只打印邮件预览（含验证/重置链接），生产环境会拒绝发送
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="YYC³ <no-reply@yyc3.vip>"

# ---- 数据库（阶段 A 已接入）----
# 已定案：NAS 主、Mac 备，两台主机各监听 5433；真实主机地址仅写入 .env.local
# DATABASE_URL=postgres://yyc3_app:CHANGE_ME@CHANGE_ME_NAS_HOST:5433/yyc3_agent?sslmode=prefer
# DATABASE_REPLICA_URL=postgres://yyc3_ro:CHANGE_ME@CHANGE_ME_MAC_HOST:5433/yyc3_agent?sslmode=prefer
# DATABASE_POOL_MAX=10

# ---- 运行时日志 ----
# debug | info | warn | error | silent
LOG_LEVEL=info
