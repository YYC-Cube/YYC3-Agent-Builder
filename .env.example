# YYC³ Agent Builder - Environment Variables
# Copy this file to .env.local and fill in your values

# Google AI (Required - for Gemini models and image generation)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here

# OpenAI (Optional - for GPT models if used in workflows)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Optional - for Claude models; see lib/model-resolver.ts)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI (Optional - for Grok models via OpenAI-compatible endpoint; see lib/model-resolver.ts)
XAI_API_KEY=your_xai_api_key_here
